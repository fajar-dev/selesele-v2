# Copy to .env.docker. This file is read by Compose, never baked into images.
# For production, use your public domain, e.g. https://notes.example.com.
APP_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=sele_sele
DB_USER=selesele
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate each secret separately:
# bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Entra Web redirect URI: APP_ORIGIN/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional OpenAI-compatible writing gateway, reachable from containers.
AI_BASE_URL=http://192.168.100.104:20128/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.6-luna

# Optional notification email, delivered by the background database outbox.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true for implicit TLS (typically 465); false for STARTTLS/custom ports.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Set when SMTP_HOST is an IP but the TLS certificate uses a DNS name.
SMTP_TLS_SERVERNAME=

# Optional backups. Local CLI requires mysql, mysqldump, tar and gzip.
# BACKUP_MYSQL_CONTAINER=mysql uses client tools in an existing Docker container.
BACKUP_DIR=.data/backups
BACKUP_HOUR_UTC=18
BACKUP_RETENTION_DAYS=14
# RESTORE_UID=1000
# RESTORE_GID=1000
