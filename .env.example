# One origin serves both the UI and API. Production requires HTTPS.
APP_ORIGIN=http://localhost:3000
PORT=3000

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=development
DB_NAME=sele_sele

# Microsoft Entra ID: single-tenant Web app registration.
# Redirect URI: APP_ORIGIN/api/auth/microsoft/callback
MICROSOFT_ENABLED=true
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google OAuth Web client. Redirect URI: APP_ORIGIN/api/auth/google/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# AI writing assistance (optional)
# Base URL includes /v1; requests use /chat/completions.
AI_BASE_URL=http://192.168.100.104:20128/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.6-luna

# Persistent image volume; keep it outside .output when deploying.
UPLOAD_DIR=.data/uploads
# Image upload storage: local (default) or cloud (AWS S3, Cloudflare R2, MinIO).
UPLOAD_STORAGE=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_PREFIX=selesele/images
S3_ADDRESS_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Optional notification email, delivered by the background database outbox.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true for implicit TLS (typically 465); false for STARTTLS/custom ports.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Set when SMTP_HOST is an IP but the TLS certificate uses a DNS name.
SMTP_TLS_SERVERNAME=

# Optional backups. Local CLI requires mysql, mysqldump, tar and gzip.
# BACKUP_MYSQL_CONTAINER=mysql uses client tools in an existing Docker container.
BACKUP_DIR=.data/backups
BACKUP_HOUR_UTC=18
BACKUP_RETENTION_DAYS=14
# RESTORE_UID=1000
# RESTORE_GID=1000
