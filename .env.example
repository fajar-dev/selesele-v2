# One origin serves both the UI and API. Production requires HTTPS.
APP_ORIGIN=http://localhost:3000
PORT=3000

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=development
DB_NAME=sele_sele

# Microsoft Entra ID: single-tenant Web app registration.
# Redirect URI: APP_ORIGIN/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# AI writing assistance (optional)
# Base URL includes /v1; requests use /chat/completions.
AI_BASE_URL=http://192.168.100.104:20128/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.6-luna

# Persistent image volume; keep it outside .output when deploying.
UPLOAD_DIR=.data/uploads

# Optional notification email, delivered by the background database outbox.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true for implicit TLS (typically 465); false for STARTTLS/custom ports.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Set when SMTP_HOST is an IP but the TLS certificate uses a DNS name.
SMTP_TLS_SERVERNAME=
